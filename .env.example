# Copia este archivo como .env y completa los valores reales.
NODE_ENV=development
PORT=3000
# Render usa un proxy inverso; localmente puedes definir TRUST_PROXY=false.
TRUST_PROXY=1
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/cafeteria
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# URL pública HTTPS del backend, sin barra final. Se usa para construir imageUrl.
PUBLIC_BASE_URL=http://localhost:3000
# Recomendado si este despliegue sirve una única cafetería. Debe coincidir con businesses.slug.
PUBLIC_BUSINESS_SLUG=
# Recomendado para imágenes persistentes en Render/Supabase; bucket público de solo lectura para el catálogo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cafeteria-products
# Carpeta persistente para imágenes. En hosting con disco efímero, montar un disco persistente aquí.
UPLOAD_DIR=./storage/uploads
MAX_IMAGE_BYTES=5242880

# Configuración segura del alta inicial. Se usa solo con `npm run bootstrap-owner`.
BOOTSTRAP_BUSINESS_NAME=
BOOTSTRAP_BUSINESS_SLUG=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_IDENTIFIER=
BOOTSTRAP_OWNER_PASSWORD=
BUSINESS_TIME_ZONE=America/Havana

# Firebase Admin: pega el JSON de la cuenta de servicio como una sola variable protegida,
# o configura GOOGLE_APPLICATION_CREDENTIALS con la ruta segura del archivo en el servidor.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Lista separada por comas; dejar vacía permite solo clientes que no dependen de CORS (por ejemplo Android).
ALLOWED_ORIGINS=
SESSION_DAYS=30
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10
SCHEDULER_INTERVAL_MS=5000
LOG_LEVEL=info
